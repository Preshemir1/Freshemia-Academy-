# ---------------------------------------------------------------------------
# Freshemia Academy — server settings
# Copy to .env for local use (never commit .env), or paste these into the
# environment-variable panel of your host.
# ---------------------------------------------------------------------------

# Port the portal listens on. Hosts normally set this for you.
PORT=3000

# Administrator sign-in. ADMIN_PASSWORD must be long and unique in production.
ADMIN_EMAIL=admin@freshemiaacademy.edu.ng
ADMIN_PASSWORD=change-me-before-launch

# 1 = always load the six demo applicants, 0 = never.
# Leave unset to seed only when NODE_ENV is not production.
# Use 0 on the live system.
SEED_DEMO=0

# Where db.json and secret.key live. On Render this is the mounted disk.
# DATA_DIR=./data

# Which websites may call this API from another origin.
# Leave unset to allow any origin (fine: tokens travel in headers, not cookies).
# Restrict it to your published site, e.g.:
#   ALLOWED_ORIGINS=https://preshemir1.github.io
# Several origins go in one comma-separated line; https://*.onrender.com works.
# ALLOWED_ORIGINS=

# Session lifetime in days.
SESSION_DAYS=30

# Optional: sign tokens with a value you control instead of data/secret.key.
# SESSION_SECRET=
